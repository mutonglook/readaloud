    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "puppeteer-core": "^25.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.5"
