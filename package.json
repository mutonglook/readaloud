{
  "name": "readaloud",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "听书阁 - 支持 TXT/EPUB/PDF 等多种格式阅读与语音朗读的 Android 应用",
  "scripts": {
    "dev": "vite",
